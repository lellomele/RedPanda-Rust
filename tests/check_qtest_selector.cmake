if(CASE STREQUAL "missing")
    execute_process(COMMAND "${TEST_PROGRAM}" --suite RESULT_VARIABLE result TIMEOUT 10)
elseif(CASE STREQUAL "empty")
    execute_process(COMMAND "${TEST_PROGRAM}" --suite "" RESULT_VARIABLE result TIMEOUT 10)
elseif(CASE STREQUAL "unknown")
    execute_process(COMMAND "${TEST_PROGRAM}" --suite no-such-suite RESULT_VARIABLE result TIMEOUT 10)
elseif(CASE STREQUAL "duplicate")
    execute_process(COMMAND "${TEST_PROGRAM}" --suite settings --suite ide-services RESULT_VARIABLE result TIMEOUT 10)
elseif(CASE STREQUAL "list-conflict")
    execute_process(COMMAND "${TEST_PROGRAM}" --list-suites --suite settings RESULT_VARIABLE result TIMEOUT 10)
else()
    message(FATAL_ERROR "Unknown selector test case")
endif()
if(NOT result STREQUAL "2")
    message(FATAL_ERROR "Invalid selector should return 2, got '${result}' for ${CASE}")
endif()
